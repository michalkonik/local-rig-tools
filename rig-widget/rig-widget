#!/usr/bin/env python3
"""
rig-widget - a small always-on corner monitor for RAM and the AMD GPUs.

Answers four questions without leaving the desktop:
  how full is RAM, who fills it, how busy is each GPU, who is using each GPU.

Design rules (measured on a 4x Radeon AI PRO R9700 AMD box, works on any
amdgpu card whose /sys/class/drm nodes your user can read - usually member of
group render/video):
  * data sources are cheap sysfs + /proc only: one full scan costs ~25 ms and
    never wakes a runtime-suspended card (no performance counters, no rocm-smi
    subprocess per tick). rocm-smi costs ~30 MB RSS and 70 ms per call, so it is
    not used here.
  * GPU memory per process comes from /proc/<pid>/fdinfo (drm-memory-*,
    amd-requested-*), which is readable by members of group render/video.
    Values are per PASID, so the same PASID seen on several fds is taken as max,
    not sum - summing is what makes desktop compositors look like they hold
    "1197% VRAM".
  * idle / suspended cards return EBUSY from sysfs; that is normal and shown as "-".

Usage:
  rig-widget                 start (or focus) the corner widget
  rig-widget --interval 3    refresh every 3 s (default 2)
  rig-widget --corner tl     corner: br (default), tr, bl, tl
  rig-widget --width 320     widget width in pixels
  rig-widget --no-holders    bars only, no "who" lines
  rig-widget --once          print one text snapshot and exit (no window, works over SSH)
  rig-widget --json          print one JSON snapshot and exit
  rig-widget --stop          stop a running widget

Keys in the widget: q / Esc quit, h toggles the "who" lines, click = immediate refresh.

Read-only: it never touches the GPUs, never loads a model, needs no sudo.
License: MIT
"""

import argparse
import glob
import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import time

DRM = "/sys/class/drm"
PROC = "/proc"
# always the real runtime dir, even when started from an SSH shell where
# XDG_RUNTIME_DIR is unset - otherwise --stop looks in the wrong place.
_RUNTIME = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
PIDFILE = os.path.join(_RUNTIME, "rig-widget.pid")
IGNORE_COMMS = {"rig-widget", "amdgpu_top", "pgrep", "ps"}
args_no_models = {"on": False}  # set by main(); snapshot() is also used by --json/--once


# ----------------------------------------------------------------- GPU cards
# PCI device id -> short name, so the widget labels cards without calling lspci
# (~90 ms). Unknown ids fall back to the id itself. Add to this dict for new cards.
PCI_ID_NAMES = {
    "1002:7551": "R9700",      # AMD Radeon AI PRO R9700 (gfx1201)
    "1002:13C0": "iGPU",       # integrated graphics - never used for models
    "1002:7471": "RX7900",
    "1002:744C": "RX7900XTX",
}


def card_label(pci, vendor_id):
    return PCI_ID_NAMES.get(vendor_id, vendor_id or "GPU")


def discover_cards():
    """Every DRM card with the amdgpu sysfs interface, sorted by PCI address.

    Returns a list of dicts: card, name, pci, vendor_id, busy, vram_used,
    vram_total (the last three are sysfs paths).
    """
    cards = []
    for dev in glob.glob(f"{DRM}/card[0-9]*/device"):
        if not os.path.exists(f"{dev}/mem_info_vram_total"):
            continue
        card = dev.split("/")[-2]
        pci, vendor_id = "unknown", "?"
        try:
            # /sys/class/drm/cardN/device resolves to .../<bridge>/<0000:03:00.0>
            # - the LAST path element is the card's own PCI address. The earlier
            # ones are PCIe bridges; matching against one of those is how a naive
            # parse ends up comparing against a device no process ever opens
            # (fdinfo reports drm-pdev as the card address, e.g. 0000:03:00.0).
            real = os.path.realpath(dev)
            cand = os.path.basename(real)
            if re.fullmatch(r"[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-9a-f]", cand):
                pci = cand
            with open(f"{dev}/uevent") as fh:
                m = re.search(r"PCI_ID=(\S+)", fh.read())
                if m:
                    vendor_id = m.group(1)
        except OSError:
            pass
        cards.append(
            {
                "card": card,
                "name": card_label(pci, vendor_id),
                "vendor_id": vendor_id,
                "pci": pci,
                "busy": f"{dev}/gpu_busy_percent",
                "vram_used": f"{dev}/mem_info_vram_used",
                "vram_total": f"{dev}/mem_info_vram_total",
            }
        )
    cards.sort(key=lambda c: c["pci"])
    return cards


def read_int(path):
    """sysfs read that tolerates EBUSY (card runtime-suspended) and EACCES."""
    try:
        with open(path) as fh:
            return int(fh.read().strip())
    except (OSError, ValueError):
        return None


# ---------------------------------------------------------------- RAM + procs
def meminfo():
    m = {}
    try:
        with open(f"{PROC}/meminfo") as fh:
            for line in fh:
                if ":" not in line:
                    continue
                k, rest = line.split(":", 1)
                try:
                    m[k] = int(rest.split()[0]) * 1024
                except (ValueError, IndexError):
                    pass
    except OSError:
        pass
    return m


def process_table():
    """pid -> (comm, rss_bytes). VmRSS only; that is what counts against RAM."""
    out = {}
    for p in glob.glob(f"{PROC}/[0-9]*/status"):
        pid = p.split("/")[2]
        comm = None
        rss = 0
        try:
            with open(p, errors="replace") as fh:
                for line in fh:
                    if line.startswith("Name:"):
                        comm = line.split(":", 1)[1].strip()
                    elif line.startswith("VmRSS:"):
                        try:
                            rss = int(line.split()[1]) * 1024
                        except (ValueError, IndexError):
                            rss = 0
                        break
        except OSError:
            continue
        if comm is not None:
            out[pid] = (comm, rss)
    return out


# Per-scan caches. Reading one /proc/*/cmdline costs ~0.05 ms, but model and
# harness discovery wants them for every process, and child_pids() wants the
# whole parent/child map once per caller - which without caching means a full
# /proc walk per model server and per harness. One scan per refresh instead.
_SCAN = {"cmdline": {}, "kids": None}


def begin_scan():
    _SCAN["cmdline"] = {}
    _SCAN["kids"] = None


STATE_FILE = os.path.expanduser("~/.config/rig-widget/state.json")


def load_state():
    """Last session's window choices (front/back, who-lines). Missing file = defaults."""
    try:
        with open(STATE_FILE) as fh:
            data = json.load(fh)
        return {"back": bool(data.get("back", False)),
                "show_who": bool(data.get("show_who", True))}
    except (OSError, ValueError):
        return {"back": False, "show_who": True}


def save_state(state):
    try:
        os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
        with open(STATE_FILE, "w") as fh:
            json.dump({"back": bool(state.get("back")),
                       "show_who": bool(state.get("show_who"))}, fh)
    except OSError:
        pass  # a widget that cannot persist its look still watches fine


def read_cmdline(pid):
    """Command line as one string ('' when the process vanished or is a kernel thread)."""
    cached = _SCAN["cmdline"].get(pid)
    if cached is not None:
        return cached
    try:
        with open(f"{PROC}/{pid}/cmdline", "rb") as fh:
            text = fh.read().replace(b"\0", b" ").decode("utf8", "replace").strip()
    except OSError:
        text = ""
    _SCAN["cmdline"][pid] = text
    return text


def container_of(pid):
    """Docker container id (12 hex) a process runs in, or None. World-readable."""
    try:
        with open(f"{PROC}/{pid}/cgroup") as fh:
            m = re.search(r"docker[-/]?([0-9a-f]{12,64})", fh.read())
        return m.group(1)[:12] if m else None
    except OSError:
        return None


_DOCKER_CACHE = {"t": 0.0, "id2name": {}, "ip2name": {}}


def docker_maps(max_age=30.0):
    """({container-id: name}, {container-ip: name}), refreshed at most every max_age.

    `docker ps` + one inspect pass costs ~40 ms, so it is cached: knowing that
    "this socket came from 172.17.0.2" is only useful as "Open WebUI".
    """
    now = time.time()
    if now - _DOCKER_CACHE["t"] < max_age and _DOCKER_CACHE["id2name"]:
        return _DOCKER_CACHE["id2name"], _DOCKER_CACHE["ip2name"]
    id2name, ip2name = {}, {}
    if shutil.which("docker"):
        try:
            out = subprocess.run(
                ["docker", "ps", "--format", "{{.ID}}\t{{.Names}}"],
                capture_output=True, text=True, timeout=5,
            ).stdout
            for line in out.splitlines():
                if "\t" in line:
                    cid, name = line.split("\t", 1)
                    id2name[cid[:12]] = name.lstrip("/")
            if id2name:
                out = subprocess.run(
                    ["docker", "inspect", "--format",
                     "{{range .NetworkSettings.Networks}}{{.IPAddress}} {{end}}\t{{.Name}}",
                     *id2name.keys()],
                    capture_output=True, text=True, timeout=5,
                ).stdout
                for line in out.splitlines():
                    if "\t" not in line:
                        continue
                    ips, name = line.split("\t", 1)
                    for ip in ips.split():
                        if ip:
                            ip2name[ip] = name.lstrip("/")
        except (OSError, subprocess.SubprocessError):
            pass
    _DOCKER_CACHE.update(t=now, id2name=id2name, ip2name=ip2name)
    return id2name, ip2name


def gpu_holders():
    """{(pci, pid): (comm, vram, gtt, resident_vram)} from amdgpu fdinfo.

    Two fields per PASID, and the difference matters:
      amd-requested-vram/gtt  what the process asked the driver to place there -
                              the useful "who is using this card" number.
      drm-memory-vram (resident) every mapping the process holds, INCLUDING
                              buffers shared with other processes. A compositor
                              with 4 GL contexts reports the whole shared arena
                              once per context, so any cross-fd sum prints
                              "380 GB" on a 32 GB card (amdgpu_top shows the
                              same as "1197%").

    So the display uses requested; resident is kept in JSON for debugging.
    Values are per PASID -> repeated fds take max(), never sum.
    GTT = GPU pages living in system RAM, the number that explains a full 60 GB.
    """
    best = {}
    for f in glob.glob(f"{PROC}/[0-9]*/fdinfo/*"):
        try:
            with open(f, errors="replace") as fh:
                txt = fh.read()
        except OSError:
            continue
        if "drm-driver:\tamdgpu" not in txt:
            continue
        pid = f.split("/")[2]
        d = {}
        for line in txt.split("\n"):
            if ":\t" in line:
                k, v = line.split(":\t", 1)
                d[k.strip()] = v.strip()
        pci = d.get("drm-pdev", "?")
        req_vram = kib(d.get("amd-requested-vram"))
        res_vram = kib(d.get("drm-memory-vram"))
        gtt = max(kib(d.get("amd-requested-gtt")), kib(d.get("drm-resident-gtt")))
        shown = req_vram or res_vram
        if shown + gtt < 32 * 1024 * 1024:  # ignore sub-32MiB noise
            continue
        try:
            comm = open(f"{PROC}/{pid}/comm").read().strip()
        except OSError:
            comm = "?"
        key = (pci, pid)
        prev = best.get(key, (comm, 0, 0, 0))
        best[key] = (comm, max(prev[1], shown), max(prev[2], gtt), max(prev[3], res_vram))
    return best


def kib(text):
    """'32391584 KiB' -> bytes."""
    if not text:
        return 0
    parts = text.split()
    try:
        n = int(float(parts[0]))
    except (ValueError, IndexError):
        return 0
    unit = parts[1].lower() if len(parts) > 1 else "kib"
    return n * {"b": 1, "kib": 1024, "mib": 1024**2, "gib": 1024**3}.get(unit, 1024)


