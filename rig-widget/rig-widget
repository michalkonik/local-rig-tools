LLAMA_SWAP_URL = os.environ.get("LLAMA_SWAP_URL", "http://127.0.0.1:8080")
_SWAP_CACHE = {"t": 0.0, "data": {}}


def llama_swap_state(max_age=1.5):
    """{port: {alias, state, title}} from llama-swap, plus whether it is up.

    llama-swap knows the *friendly* model name (the config.yaml alias) that the
    engine's own command line does not; the engine only knows its weights file.
    Answering from cache keeps the refresh interval honest.
    """
    now = time.time()
    if now - _SWAP_CACHE["t"] < max_age:
        return _SWAP_CACHE["data"]
    out = {}
    try:
        import urllib.request

        with urllib.request.urlopen(f"{LLAMA_SWAP_URL}/running", timeout=0.8) as fh:
            data = json.load(fh)
        for r in data.get("running", []):
            cmd = " ".join((r.get("cmd") or "").split())
            # Key the entry by the port its engine listens on. Compose-based
            # entries carry "PORT=5807"; plain llama.cpp entries carry
            # "--port 5810" (the ${PORT} macro already substituted), and the
            # proxy URL is the last resort. A missed key printed "?" for a
            # model whose real name llama-swap had been telling us all along.
            port = None
            for pat in (r"\bPORT=(\d+)", r"--(?:port|api-port)[= ]+(\d+)",
                        r"://[\w.]+:(\d+)"):
                m = re.search(pat, cmd) or re.search(pat, r.get("proxy") or "")
                if m:
                    port = int(m.group(1))
                    break
            if port:
                out[port] = {
                    "alias": r.get("model") or "?",
                    "state": r.get("state") or "?",
                    "title": r.get("name") or "",
                    "cmd": cmd,
                }
    except Exception:
        pass  # llama-swap down or slow: fall back to process scanning alone
    _SWAP_CACHE.update(t=now, data=out)
    return out


def child_pids(parents):
    """All descendants of the given pids; the parent/child map is built once per scan."""
    if _SCAN["kids"] is not None:
        kids = _SCAN["kids"]
    else:
        kids = _build_kids()
        _SCAN["kids"] = kids
    seen, queue = set(int(p) for p in parents), list(int(p) for p in parents)
    while queue:
        for kid in kids.get(queue.pop(), []):
            if kid not in seen:
                seen.add(kid)
                queue.append(kid)
    return seen


def _build_kids():
    kids = {}
    for stat in glob.glob(f"{PROC}/[0-9]*/stat"):
        try:
            with open(stat) as fh:
                txt = fh.read()
            pid = int(txt[: txt.rindex(")")].split()[-1]) if ")" in txt else int(txt.split()[0])
            ppid = int(txt[txt.rindex(")") + 2 :].split()[1])
        except (OSError, ValueError, IndexError):
            continue
        kids.setdefault(ppid, []).append(pid)
    return kids


def pci_to_index(cards):
    """PCI -> widget GPU index (both are PCI-sorted, so this equals amd-smi/HIP order)."""
    return {c["pci"]: (f"iGPU" if c["name"] == "iGPU" else f"GPU{i}")
            for i, c in enumerate(cards)}


def model_servers(procs, holders, pci_names=None):
    """What model is loaded, in which engine, on which cards, held by which pids.

    The kernel knows only PIDs, so the model name has to come from somewhere
    else: the engine's own command line (--model ..., `vllm serve ...`) and, for
    the friendly alias, llama-swap's /running. Nothing here needs root.
    """
    id2name, _ = docker_maps()
    swap = llama_swap_state()
    servers = []
    for pid in list(procs):
        cmd = read_cmdline(pid)
        if not cmd:
            continue
        argv0 = os.path.basename(cmd.split(" ", 1)[0])
        engine = ENGINE_ARGV0.get(argv0)
        if engine is None:
            if re.search(r"\bpython[0-9.]*\s+\S*vllm\s+serve\b|\bvllm\s+serve\b", cmd):
                engine = "vLLM"
            elif "llama-server" in cmd:
                engine = "llama.cpp"
            else:
                continue
        # llama-swap itself is the proxy, not a model: it is the router row.
        is_proxy = argv0 == "llama-swap" or "--watch-config" in cmd
        model, friendly = None, None
        # llama.cpp: "llama-server --port ... -m /path/model.gguf" (llama-swap
        # cmds carry NEWLINES between args, so every separator is [\s=]+). Its
        # --alias is the friendly name. vLLM: "vllm serve /path --served-model-name=x".
        # radiance: --model file.rad. Tolerant patterns beat a strict flag list:
        # flag names drift between engine versions, "flag then path" does not.
        def flag(*names):
            alt = "|".join(re.escape(n) for n in names)
            return re.compile(r"(?:^|\s)-(?:%s)[=\s]+(\S+)" % alt)

        m = flag("model", "model-path", "gguf", "checkpoint").search(cmd)
        if not m:
            m = re.search(r"(?:^|\s)-m[=\s]+(\S+)", cmd)  # llama.cpp short form
        if m:
            model = m.group(1)
        m = flag("alias", "served-model-name").search(cmd)
        if m:
            friendly = m.group(1)
        if not model:
            m = re.search(r"(?:^|\s)vllm\s+serve\s+(\S+)", cmd)
            if m:
                model = m.group(1)
        if model:
            friendly = friendly or None
        port = None
        m = re.search(r"--(?:port|api-port|grpc-port)[= ]+(\d+)", cmd)
        if m:
            port = int(m.group(1))
        if is_proxy:
            port = port or 8080
        if not model and not is_proxy:
            model = "?"
        if is_proxy:
            model = None
        # The engine process is usually not the one holding the GPU fds: with
        # docker/ROCm the driver sees the container's process, and llama-swap
        # never touches the card at all. So walk the whole process family and
        # keep whichever members actually appear in fdinfo.
        pid_i = int(pid)
        family = child_pids([pid_i]) | {pid_i}
        fd_pids = {int(q) for (_pci, q) in holders if str(q).isdigit()}
        pids = sorted(family & fd_pids) or [pid_i]
        gpus = {}
        for (pci, q), (_c, vram, gtt, _r) in holders.items():
            if str(q).isdigit() and int(q) in pids:
                g = gpus.setdefault(pci, [0, 0])
                g[0] = max(g[0], vram)
                g[1] = max(g[1], gtt)
        info = swap.get(port, {}) if port else {}
        if not info and port:
            # llama-swap did not key by this port (proxy missing, PORT= elsewhere
            # in the cmd): scan its entries instead of showing "?" for a model we
            # can actually name.
            for _p, ent in swap.items():
                c = ent.get("cmd") or ""
                if re.search(rf"PORT={port}(?:\D|$)", c) or re.search(rf"(?:--port|:){port}(?:\D|$)", c):
                    info = ent
                    break
        servers.append(
            {
                "engine": engine,
                "pid": int(pid),
                "pids": pids,
                "port": port,
                "proxy": is_proxy,
                "model_raw": model,
                "friendly": friendly,
                "alias": info.get("alias"),
                "state": info.get("state"),
                "title": info.get("title"),
                "container": id2name.get(container_of(pid) or "", None),
                "gpus": {(pci_names or {}).get(p, p): v for p, v in gpus.items()},
            }
        )
    # A model that is loaded but whose process we cannot see (other user, or
    # llama-swap reporting it) still deserves a row.
    for port, info in swap.items():
        if not any(sv.get("port") == port and not sv["proxy"] for sv in servers):
            servers.append(
                {
                    "engine": "?",
                    "pid": None,
                    "pids": [],
                    "port": port,
                    "proxy": False,
                    "model_raw": None,
                    "friendly": None,
                    "alias": info.get("alias"),
                    "state": info.get("state"),
                    "title": info.get("title"),
                    "container": None,
                    "gpus": {},
                }
            )
    servers.sort(key=lambda sv: (sv["proxy"], sv["alias"] or sv["model_raw"] or ""))
    return servers


def established():
    """[(local_ip, local_port, peer_ip, peer_port, peer_comm, peer_pid)] from `ss`.

    One ss call costs ~20 ms, affordable every refresh. The columns are picked by
    shape, not by index, because `ss ... state established` omits the State column
    that plain `ss` prints - trusting fixed indexes silently swaps local and peer,
    which turns every client into "some remote host".
    """
    if not shutil.which("ss"):
        return []
    try:
        out = subprocess.run(
            ["ss", "-tnp", "state", "established"],
            capture_output=True, text=True, timeout=3,
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return []

    def split_addr(a):
        """'[::ffff:172.17.0.2]:51748' / '127.0.0.1:8080' -> (ip, port).

        ss wraps IPv6 (and IPv4-mapped IPv6, which is how Docker traffic shows
        up) in brackets, so the port has to come off the end BEFORE the brackets
        are stripped - stripping first leaves a ']' on the address and then no
        address ever matches the docker IP map.
        """
        if "]" in a:
            head, sep, tail = a.rpartition("]")
            ip = head.lstrip("[")
            port = tail.lstrip(":")
        else:
            head, sep, tail = a.rpartition(":")
            ip, port = head, tail
        if not port.isdigit():
            return a, None
        if ip.startswith("::ffff:"):  # IPv4-mapped IPv6 -> plain IPv4, so the
            ip = ip[7:]                # docker map (172.17.0.2) matches it
        if ip == "::1":
            ip = "127.0.0.1"
        return ip, int(port)

    def is_addr(tok):
        _ip, port = split_addr(tok)
        return port is not None and (":" in tok or "." in tok)

    rows = []
    for line in out.splitlines()[1:]:
        cols = line.split()
        addrs = [c for c in cols if is_addr(c)]
        if len(addrs) < 2:
            continue
        lip, lport = split_addr(addrs[0])
        pip, pport = split_addr(addrs[1])
        comm, pid = None, None
        m = re.search(r'users:\(\("(.+?)",pid=(\d+)', line)
        if m:
            comm, pid = m.group(1), int(m.group(2))
        rows.append((lip, lport, pip, pport, comm, pid))
    return rows


def harness_label(pid, comm, ip, ip2name, id2name):
    """Human name of whatever is driving a model: a harness, an app, a person."""
    if ip and ip in ip2name:
        name = ip2name[ip]
        return {"open-webui": "Open WebUI", "openwebui-https": "Open WebUI (https)"}.get(name, name)
    if pid:
        cmd = read_cmdline(pid)
        for needle, label in HARNESS_LABELS:
            if needle in (cmd or "") or needle == (comm or ""):
                return label
        cid = container_of(pid)
        if cid and cid in id2name:
            return id2name[cid]
    if comm:
        for needle, label in HARNESS_LABELS:
            if needle == comm:
                return label
        return comm
    return ip or "remote"


def harness_processes(procs, model_ports, rows=None, maps=None):
    """Harnesses/agents running on this box, and whether each is connected now.

    An agent between two requests holds no socket, so "who uses the models" is
    incomplete without also listing the harnesses that exist but are idle.
    model_ports is used only to say which of them has a live connection right now.
    """
    agents = ("openclaw", ".npm-global/lib/node_modules/openclaw", "open_webui",
              "open-webui", "rig_tools.py", "cryptoagent", "deal-hunter", "comfy",
              "speaches")
    id2name, ip2name = maps if maps else docker_maps()
    connected_pids, connected_ips = set(), set()
    for _lip, lport, pip, _pport, _comm, pid in (rows if rows is not None else established()):
        if lport in model_ports:
            if pid:
                connected_pids.add(pid)
            if pip:
                connected_ips.add(pip)
    name2ip = {v: k for k, v in ip2name.items()}
    out, seen = [], set()
    for pid in procs:
        cmd = read_cmdline(pid)
        if not cmd:
            continue
        label = None
        for needle in agents:
            if needle in cmd:
                label = dict(HARNESS_LABELS).get(needle)
                break
        if not label:
            continue
        if label in seen:
            continue
        seen.add(label)
        family = child_pids([int(pid)]) | {int(pid)}
        cname = id2name.get(container_of(pid) or "", None)
        live = bool(family & connected_pids) or (cname in name2ip and name2ip[cname] in connected_ips)
        out.append({
            "label": label,
            "pid": int(pid),
            "live": live,
            "container": cname,
        })
    out.sort(key=lambda h: (not h["live"], h["label"]))
    return out


def clients_of(rows, port, skip_pids=()):
    """{label: connections} for every client currently connected to `port`.

    Reading this needs both directions of ss output, and the reason is subtle:

      * a host process client produces TWO rows (its own client-side row, which
        names it, plus the server's row). The client-side row is the informative
        one: on the server row the process column names the listener instead.
      * a container client produces only the SERVER row, because the container's
        half of the connection lives in another network namespace that plain
        `ss` cannot see. Those clients are named from their source IP through the
        docker address map - which is how "Open WebUI" is credited here, since it
        runs in a container.

    So: name what the client-side rows reveal, then name whatever the server-side
    rows show that no client-side row claimed.
    """
    id2name, ip2name = docker_maps()
    named = {
        "open-webui": "Open WebUI",
        "openwebui-https": "Open WebUI (https)",
        "speaches": "Speaches (voice)",
    }
    out = {}
    claimed = set()
    for _lip, _lport, pip, pport, comm, pid in rows:
        if pport != port:
            continue
        claimed.add((_lip, _lport))
        if pid and pid in skip_pids:
            continue
        label = harness_label(pid, comm, pip, ip2name, id2name)
        out[label] = out.get(label, 0) + 1
    for lip, lport, pip, pport, _comm, _pid in rows:
        if lport != port or (pip, pport) in claimed:
            continue
        if pip in ip2name:
            label = named.get(ip2name[pip], ip2name[pip])
        elif pip.startswith(("127.", "::1")):
            label = "localhost"      # host process whose client row we could not read
        else:
            label = f"remote {pip}"
        out[label] = out.get(label, 0) + 1
    return out


SELF_PIDS = {os.getpid()}


def model_users(servers, rows=None):
    """Attach to each model: whether it is mid-request and who drives it.

    Two hops are joined: client -> router and router -> engine. A model counts as
    in use only while the router itself holds a socket to that engine's port;
    otherwise a browser merely reading the router UI would look like it was using
    the model. The router is then replaced by what is behind it, because a proxy
    is a pipe and not a user.
    """
    for sv in servers:
        sv["users"] = []
        sv["in_flight"] = False
    if rows is None:
        rows = established()
    proxies = [sv for sv in servers if sv["proxy"]]
    proxy_pids = {px["pid"] for px in proxies if px.get("pid")}

    for px in proxies:
        if px.get("port"):
            px["users"] = [
                {"label": lab, "conns": n, "via_proxy": None}
                for lab, n in sorted(clients_of(rows, px["port"], proxy_pids | SELF_PIDS).items(),
                                     key=lambda x: -x[1])
            ]

    # Which engine ports does the router itself hold live sockets to? Only those
    # models can count as "mid request" - a browser idling on the router UI keeps
    # a socket to the router but the router keeps none to the engine.
    router_targets = {pport for _lip, _lport, _pip, pport, _comm, pid in rows
                      if pport and pid in proxy_pids}
    for sv in servers:
        if sv["proxy"] or not sv.get("port"):
            continue
        skip = ({sv["pid"]} if sv.get("pid") else set()) | SELF_PIDS
        direct = clients_of(rows, sv["port"], skip)
        sv["users"] = [{"label": lab, "conns": n, "via_proxy": None}
                       for lab, n in sorted(direct.items(), key=lambda x: -x[1])]
        if sv["port"] in router_targets:
            sv["in_flight"] = True
            behind = {}
            for px in proxies:
                if not px.get("port"):
                    continue
                for u in px["users"]:
                    behind[u["label"]] = behind.get(u["label"], 0) + u["conns"]
            if behind:
                sv["users"] = [{"label": lab, "conns": n, "via_proxy": "llama-swap"}
                               for lab, n in sorted(behind.items(), key=lambda x: -x[1])]
    return servers


def snapshot():
    """One cheap read of everything the widget shows."""
    begin_scan()
    mem = meminfo()
    total = mem.get("MemTotal", 0)
    avail = mem.get("MemAvailable", 0)
    procs = process_table()
    top_ram = sorted(
        ((c, r, p) for p, (c, r) in procs.items() if c not in IGNORE_COMMS),
        key=lambda x: -x[1],
    )[:4]

    holders = gpu_holders()
    by_pci = {}
    for (pci, pid), (comm, vram, gtt, resident) in holders.items():
        by_pci.setdefault(pci, []).append(
            {"comm": comm, "pid": int(pid), "vram": vram, "gtt": gtt, "resident_vram": resident}
        )

    card_list = discover_cards()
    gpus = []
    for card in card_list:
        used = read_int(card["vram_used"])
        tot = read_int(card["vram_total"]) or 1
        busy = read_int(card["busy"])
        people = sorted(by_pci.get(card["pci"], []), key=lambda h: -(h["vram"] + h["gtt"]))[:3]
        gpus.append(
            {
                "card": card["card"],
                "name": card["name"],
                "pci": card["pci"],
                "busy": busy,          # None == suspended / unreadable
                "vram_used": used,     # None == suspended / unreadable
                "vram_total": tot,
                "holders": people,
            }
        )

    if args_no_models.get("on"):
        servers, harnesses = None, []   # None == "not measured", not "nothing loaded"
    else:
        rows = established()  # one ss call feeds both the users join and liveness
        servers = model_users(model_servers(procs, holders, pci_to_index(card_list)), rows)
        ports = {sv["port"] for sv in servers if sv.get("port")}
        harnesses = harness_processes(procs, ports, rows, docker_maps())
        harnesses = [h for h in harnesses if h["label"] != "llama-swap"]

    return {
        "t": time.strftime("%H:%M:%S"),
        "host": socket.gethostname(),
        "servers": servers,
        "harnesses": harnesses,
        "ram_total": total,
        "ram_avail": avail,
        "ram_used": total - avail,
        "swap_total": mem.get("SwapTotal", 0),
        "swap_free": mem.get("SwapFree", 0),
        "top_ram": [{"comm": c, "rss": r, "pid": p} for c, r, p in top_ram],
        "gpus": gpus,
    }


# ----------------------------------------------------------------- text mode
def gb(n):
    if n is None:
        return "-"
    return f"{n / 1024**3:.1f}G"


def bar(frac, width=24):
    if frac is None:
        return "[" + "?" * width + "]"
    n = int(round(frac * width))
    return "[" + "#" * n + "." * max(0, width - n) + "]"


def model_label(sv):
    """Best human name: llama-swap alias > engine --alias > weights filename."""
    for key in ("alias", "friendly"):
        if sv.get(key):
            return sv[key]
    raw = sv.get("model_raw") or "?"
    base = os.path.basename(raw)
    for ext in (".rad", ".gguf", ".safetensors"):
        base = base.replace(ext, "")
    return base


def server_line(sv):
    """One compact line: model  engine  cards+VRAM  [state]"""
    if sv.get("proxy"):
        # The router holds no model of its own; every client goes through it
        # before reaching the model rows, so say what it does, not "?".
        return f"llama-swap router :{sv.get('port')} - all clients pass through here"
    parts = [model_label(sv)]
    cards = [f"{name} {gb(v)}".rstrip() for name, (v, _g) in sv["gpus"].items()]
    how = sv["engine"] + (f" on {' + '.join(cards)}" if cards else "")
    if sv.get("state") and sv["state"] != "ready":
        how += f" ({sv['state']})"
    parts.append(how)
    return "\n    ".join(parts)


def users_line(sv):
    """Who is talking to this model right now, through whatever router."""
    users = sv.get("users") or []
    names = ", ".join(
        u["label"] + (f" x{u['conns']}" if u["conns"] > 1 else "")
        + (" (via llama-swap)" if isinstance(u.get("via_proxy"), str) else "")
        for u in users
    )
    if sv["proxy"]:
        return "clients: " + names if users else "clients: none connected"
    if not users:
        return "used by: nobody right now"
    if sv.get("in_flight"):
        return "ANSWERING NOW: " + names
    return "connected: " + names + " (no request running)"


def render_text(s):
    L = []
    ramf = (s["ram_used"] / s["ram_total"]) if s["ram_total"] else None
    used_used = s["ram_total"] - s["ram_avail"]
    L.append(f"{s['host']}  {s['t']}")
    L.append(
        f"RAM  {bar(ramf)}  {gb(used_used)}/{gb(s['ram_total'])}  "
        f"avail {gb(s['ram_avail'])}  swap {gb(s['swap_total'] - s['swap_free'])}/{gb(s['swap_total'])}"
    )
    L.append("     " + "  ".join(f"{p['comm']} {gb(p['rss'])}" for p in s["top_ram"]))
    if s.get("servers") is not None:
        sv_list = s["servers"]
        models = [x for x in sv_list if not x["proxy"]]
        L.append(("LOADED MODELS" if models else "NO MODEL LOADED") if sv_list else "NO MODEL LOADED")
        for sv in sv_list:
            L.append("  " + server_line(sv))
            L.append("     -> " + users_line(sv))
        if s.get("harnesses"):
            L.append("     tools: " + "  ".join(
                (h["label"] + " (using now)" if h["live"] else h["label"])
                for h in s["harnesses"]))
    # PCI order == amd-smi / HIP index order on this rig, so GPU0 here is GPU0
    # in gpu-status, rocm-smi and torch. The iGPU keeps its own name.
    for i, g in enumerate(s["gpus"]):
        bf = (g["busy"] / 100.0) if g["busy"] is not None else None
        vf = (g["vram_used"] / g["vram_total"]) if g["vram_used"] is not None else None
        label = g["name"] if g["name"] == "iGPU" else f"GPU{i}"
        L.append(
            f"{label:<5} {bar(bf, 12)} {str(g['busy']) + '%' if g['busy'] is not None else '  -  ':>5}  "
            f"VRAM {bar(vf, 12)} {gb(g['vram_used'])}/{gb(g['vram_total'])}  {g['pci']}"
        )
        if g["holders"]:
            who = "  ".join(
                f"{h['comm']} {gb(h['vram'])}" + (f" +gtt {gb(h['gtt'])}" if h["gtt"] > 1024**3 else "")
                for h in g["holders"]
            )
            L.append("     " + who)
    return "\n".join(L)


