def live_x_display():
    """(display, xauthority) of the running desktop, found from Xwayland itself.

    The desktop is GNOME on Wayland; mutter starts one Xwayland per session and
    passes its own -auth cookie path, whose name changes at every login
    (.mutter-Xwaylandauth.XXXXXX). Reading it from the process command line is
    the only way that survives reboots and re-logins - and it lets this widget be
    started from a headless shell (SSH, an agent, cron) and still draw on screen.
    Returns (None, None) when no Xwayland is running.
    """
    env_disp = os.environ.get("DISPLAY")
    env_auth = os.environ.get("XAUTHORITY")
    if env_disp and env_auth and os.path.exists(env_auth):
        return env_disp, env_auth
    for status in glob.glob(f"{PROC}/[0-9]*/cmdline"):
        try:
            args = open(status, "rb").read().split(b"\0")
        except OSError:
            continue
        args = [a.decode("utf8", "replace") for a in args if a]
        if not args or not os.path.basename(args[0]).startswith("Xwayland"):
            continue
        disp, auth = None, None
        for i, a in enumerate(args):
            if a.startswith(":") and disp is None:
                disp = a
            if a == "-auth" and i + 1 < len(args):
                auth = args[i + 1]
        if disp and auth and os.path.exists(auth):
            return disp, auth
    runtime = _RUNTIME
    cookies = sorted(glob.glob(f"{runtime}/.mutter-Xwaylandauth.*"), key=os.path.getmtime, reverse=True)
    if env_disp and cookies:
        return env_disp, cookies[0]
    return None, None


def wait_for_display(seconds=0):
    """Poll for the desktop's Xwayland for up to N seconds (login autostart).

    At session start the widget can be faster than mutter starting Xwayland, and
    a widget that exits quietly on boot is worse than no widget at all.
    """
    deadline = time.time() + max(0, seconds)
    while True:
        disp, auth = live_x_display()
        if disp or time.time() >= deadline:
            return disp, auth
        time.sleep(1)


def attach_display(wait=0):
    """Point GTK at the desktop's Xwayland, before any GTK import.

    GDK_BACKEND=x11 is required, not cosmetic: without it GTK3 prefers the
    Wayland socket, and a Wayland client cannot ask to be placed in a screen
    corner or kept above other windows - which is the whole point of a widget.
    """
    disp, auth = wait_for_display(wait)
    if not disp:
        return False
    os.environ["GDK_BACKEND"] = "x11"
    os.environ["DISPLAY"] = disp
    if auth:
        os.environ["XAUTHORITY"] = auth
    else:
        os.environ.pop("XAUTHORITY", None)
    return True


def list_monitors(display):
    """[(index, name, x, y, w, h, is_primary)] - names come from the driver."""
    out = []
    for i in range(display.get_n_monitors()):
        mon = display.get_monitor(i)
        g = mon.get_geometry()
        try:
            name = mon.get_model() or "?"
        except Exception:
            name = "?"
        try:
            primary = bool(mon.is_primary())
        except Exception:
            primary = False
        out.append((i, name, g.x, g.y, g.width, g.height, primary))
    return out


def monitor_geometry(display, index=-1):
    """(x, y, width, height) of one monitor in root coordinates.

    index -1 == primary. The origin matters: this rig has a 1920x1080 panel
    *below* the 4K one (HDMI-1 +0+853, DP-1 +1920+0), so a corner computed from
    width/height alone would land on the wrong screen entirely.
    """
    try:
        if index < 0:
            mon = display.get_primary_monitor() or display.get_monitor(0)
        else:
            mon = display.get_monitor(index)
        g = mon.get_geometry()
        return g.x, g.y, g.width, g.height
    except Exception:
        return 0, 0, 1920, 1080


