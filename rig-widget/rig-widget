        ramf = ((total - avail) / total) if total else 0
        swap_used = s["swap_total"] - s["swap_free"]
        head.set_text(f"{s['host']}  {s['t']}")
        ram.set(
            ramf, None,
            f"{gb(total - avail)}/{gb(total)}",
            f"available {gb(avail)}\nswap used {gb(swap_used)} of {gb(s['swap_total'])}",
            [f"{p['comm']} {gb(p['rss'])}" for p in s["top_ram"][:3]] if state["show_who"] else (),
        )
        servers = s.get("servers")
        if servers is None:            # --no-models: section not measured at all
            models_title.set_text("")
            harness_lbl.set_text("")
        else:
            models = [sv for sv in servers if not sv["proxy"]]
            models_title.set_text("LOADED MODELS" if models else "NO MODEL LOADED")
            # Grow the pool when needed, then update text in place: rebuilding
            # every label every refresh cost 3x more CPU than the actual scan.
            while len(_MODEL_LABELS) < len(servers):
                top = Gtk.Label()
                top.set_xalign(0)
                top.set_line_wrap(True)
                top.set_max_width_chars(42)
                bot = Gtk.Label()
                bot.set_xalign(0)
                bot.set_line_wrap(True)
                bot.set_max_width_chars(42)
                bot.get_style_context().add_class("dim")
                models_box.pack_start(top, False, False, 0)
                models_box.pack_start(bot, False, False, 0)
                top.show(); bot.show()
                _MODEL_LABELS.append((top, bot))
            for (top, bot), sv in zip(_MODEL_LABELS, servers):
                top.set_text(server_line(sv))
                top.set_visible(True); bot.set_visible(True)
                tip = (sv.get("title") or "").strip()
                if sv.get("model_raw"):
                    tip += ("\n" if tip else "") + sv["model_raw"]
                if sv.get("state") and sv["state"] != "ready":
                    tip += f"\nstate: {sv['state']}"
                top.set_tooltip_text(tip or None)
                bot.set_text(users_line(sv))
            for (top, bot) in _MODEL_LABELS[len(servers):]:
                top.set_visible(False); bot.set_visible(False)
            h = s.get("harnesses") or []
            if h:
                parts = [
                    f"{x['label']} (using now)" if x["live"] else x["label"]
                    for x in h
                ]
                harness_lbl.set_text("tools: " + " · ".join(parts))
            else:
                harness_lbl.set_text("")
        build_gpu_rows(len(s["gpus"]))
        for i, (g, row) in enumerate(zip(s["gpus"], rows_gpu)):
            bf = (g["busy"] / 100.0) if g["busy"] is not None else None
            vf = (g["vram_used"] / g["vram_total"]) if g["vram_used"] is not None else None
            asleep = g["busy"] is None
            who = ()
            if state["show_who"]:
                who = tuple(
                    f"{h['comm']} {gb(h['vram'])}" + (f" gtt {gb(h['gtt'])}" if h["gtt"] > 1024**3 else "")
                    for h in g["holders"][:2]
                )
            row.set(
                bf, vf,
                "asleep" if asleep else f"{g['busy']}%  {gb(g['vram_used'])}",
                f"{g['pci']} ({g['card']})  VRAM {gb(g['vram_used'])}/{gb(g['vram_total'])}"
                + ("  - card asleep, sysfs busy returns EBUSY" if asleep else ""),
                who,
            )
            row.lbl.set_text("iGPU" if g["name"] == "iGPU" else f"GPU{i}")
        return True

    def toggle_who():
        state["show_who"] = not state["show_who"]
        save_state(state)
        refresh()
        win.show_all()
        for r in [ram] + rows_gpu:
            r.who.set_visible(state["show_who"])

    # --- the little pill left behind when the panel is switched off ----------
    pill = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    pill.set_title("rig-widget")
    pill.set_decorated(False)
    pill.set_resizable(False)
    pill.set_skip_taskbar_hint(True)
    pill.set_skip_pager_hint(True)
    pill.set_keep_above(True)
    pill.set_type_hint(Gdk.WindowTypeHint.UTILITY)
    pill.set_app_paintable(True)
    try:
        pill.set_visual(screen.get_rgba_visual())
    except Exception:
        pass
    pill.get_style_context().add_class("pill")
    pill_btn = Gtk.Button(label="⏻")
    pill_btn.set_tooltip_text("rig-widget is off (idle) - click to show it again")
    pill.add(pill_btn)

    def set_front(front):
        """keep-above is a hint mutter honors; the type hint has to change too,
        a UTILITY window tends to stay floating even with keep-above cleared."""
        state["back"] = not front
        win.set_keep_above(front)
        win.set_type_hint(Gdk.WindowTypeHint.UTILITY if front
                          else Gtk.WindowTypeHint.NORMAL)
        btn_back.set_label("front" if not front else "back")
        save_state(state)

    def stop_timer():
        if state["timer"] is not None:
            GLib.source_remove(state["timer"])
            state["timer"] = None

    def start_timer():
        stop_timer()
        state["timer"] = GLib.timeout_add(int(max(0.5, args.interval) * 1000), refresh)

    def place_pill(*_):
        mx, my, mw, mh = monitor_geometry(display, args.monitor)
        pill.move(mx + mw - 46 - 14, max(36, my + mh - 34 - 12))
        return False

    def hide_panel(*_):
        """Off = window hidden AND scanning stopped: zero CPU while it waits."""
        state["hidden"] = True
        win.hide()
        stop_timer()
        pill.show_all()
        place_pill()
        return False

    def show_panel(*_):
        state["hidden"] = False
        pill.hide()
        win.show_all()
        for r in [ram] + rows_gpu:
            r.who.set_visible(state["show_who"])
        for delay in (0, 300, 900):
            GLib.timeout_add(delay, place)
        start_timer()
        refresh()
        return False

    btn_power.connect("clicked", lambda *_: hide_panel())
    pill_btn.connect("clicked", lambda *_: show_panel())
    btn_back.connect("clicked", lambda *_: set_front(state["back"]))
    pill.connect("destroy", lambda *a: Gtk.main_quit())

    def on_key(w, e):
        if e.keyval in (Gdk.KEY_q, Gdk.KEY_Escape):
            Gtk.main_quit()
        elif e.keyval == Gdk.KEY_h:
            toggle_who()
        elif e.keyval == Gdk.KEY_b:
            set_front(state["back"])
        elif e.keyval == Gdk.KEY_o:
            hide_panel()
        return True

    win.connect("key-press-event", on_key)
    win.connect("button-press-event", lambda *a: False if state["hidden"] else refresh() or False)
    win.connect("destroy", lambda *a: Gtk.main_quit())

    refresh()
    build_gpu_rows(len(snapshot()["gpus"]))
    win.show_all()
    for r in [ram] + rows_gpu:
        r.who.set_visible(state["show_who"])

    # place in the chosen corner: override-redirect/dock windows need explicit
    # placement, and the size is only known after the first show.
    def place(*_):
        """Pin the window to a corner, using its real on-screen size.

        The size is only final after the first map, and GNOME's top bar owns the
        first ~32 px, so the top corners start at y=36 and bottom corners are
        measured from the real height. Retried a few times because the width
        settles with the first data refresh.
        """
        mx, my, mw, mh = monitor_geometry(display, args.monitor)
        try:
            _w, h = win.get_size()
        except Exception:
            h = 0
        if not h:
            h = win.get_allocated_height() or 280
        vert, horiz = CORNER_ALIGN[args.corner]
        x = mx + mw - args.width - 14 if horiz == "end" else mx + 14
        # 36 px down in the top corners: GNOME's top bar owns the first ~32 px.
        y = my + max(36, mh - h - 12) if vert == "bottom" else my + 36
        win.move(x, y)
        return False

    GLib.idle_add(place)
    for delay in (300, 900, 2000, 4000):
        GLib.timeout_add(delay, place)
    set_front(not state["back"])   # restore where the user left it last session

    # The window grows when the "who" lines appear, which pushes a bottom-corner
    # window off the screen, so re-place whenever the height settles differently.
    last = {"h": 0}

    def on_configure(_w, event):
        if abs(event.height - last["h"]) > 4:
            last["h"] = event.height
            place()
        return False

    win.connect("configure-event", on_configure)
    start_timer()

    with open(PIDFILE, "w") as fh:
        fh.write(str(os.getpid()))
    signal.signal(signal.SIGTERM, lambda *a: Gtk.main_quit())
    try:
        Gtk.main()
    finally:
        try:
            os.unlink(PIDFILE)
        except OSError:
            pass


def stop_running():
    if not os.path.exists(PIDFILE):
        print("rig-widget: not running")
        return 0
    pid = int(open(PIDFILE).read().strip())
    try:
        os.kill(pid, signal.SIGTERM)
        print(f"rig-widget: stopped (pid {pid})")
    except ProcessLookupError:
        print("rig-widget: stale pid file, cleaned")
        os.unlink(PIDFILE)
    except PermissionError:
        print(f"rig-widget: pid {pid} is not mine")
        return 1
    return 0


def main():
    ap = argparse.ArgumentParser(description="RAM + AMD GPU corner widget (read-only, no sudo)")
    ap.add_argument("--interval", type=float, default=2.0, help="refresh seconds (default 2)")
    ap.add_argument("--corner", choices=list(CORNER_ALIGN), default="br")
    ap.add_argument("--monitor", type=int, default=-1,
                    help="monitor index for --corner (-1 = primary, default)")
    ap.add_argument("--list-monitors", action="store_true", help="print monitors and exit")
    ap.add_argument("--wait-for-display", type=float, default=60,
                    help="seconds to wait for the desktop session at start (default 60)")
    ap.add_argument("--width", type=int, default=300)
    ap.add_argument("--no-holders", action="store_true", help="bars only")
    ap.add_argument("--no-models", action="store_true",
                    help="skip model/harness discovery (ss, docker, llama-swap) - cheapest mode")
    ap.add_argument("--once", action="store_true", help="print one snapshot and exit")
    ap.add_argument("--json", action="store_true", help="print one JSON snapshot and exit")
    ap.add_argument("--stop", action="store_true", help="stop the running widget")
    args = ap.parse_args()

    args_no_models["on"] = args.no_models

    if args.stop:
        sys.exit(stop_running())

    if args.list_monitors:
        if not attach_display():
            sys.exit("no live desktop display to query")
        import gi

        gi.require_version("Gdk", "3.0")
        gi.require_version("Gtk", "3.0")
        from gi.repository import Gtk

        Gtk.init_check()
        disp = Gtk.get_current_event_device() if False else None
        from gi.repository import Gdk

        for i, name, x, y, w, h, primary in list_monitors(Gdk.Display.get_default()):
            print(f"{i}  {name:<10} {w}x{h}+{x}+{y}{'  (primary)' if primary else ''}")
        return

    if args.once or args.json:
        s = snapshot()
        if args.json:
            print(json.dumps(s))
        else:
            print(render_text(s))
        return

    if os.path.exists(PIDFILE):
        try:
            pid = int(open(PIDFILE).read().strip())
            os.kill(pid, 0)
            print(f"rig-widget: already running (pid {pid}) - use --stop first")
            return
        except (ProcessLookupError, ValueError):
            pass

    try:
        run_gui(args)
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
